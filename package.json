{
  "name": "mcrcondocker",
  "version": "1.1.1",
  "description": "Selbst gehostetes Web-Dashboard für einen Minecraft-Server, ausschließlich über RCON",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/irgendeinjohan/mcrcondocker.git"
  },
  "keywords": [
    "minecraft",
    "rcon",
    "dashboard",
    "paper",
    "docker",
    "self-hosted",
    "geyser",
    "floodgate"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite",
    "mock": "MOCK=true tsx --disable-warning=ExperimentalWarning src/server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "vitest run",
    "check": "tsc -p tsconfig.server.json --noEmit && svelte-check --tsconfig ./tsconfig.web.json",
    "capture": "tsx scripts/capture-fixtures.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.56.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
