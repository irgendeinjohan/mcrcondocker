# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env enthält Passwörter – niemals committen oder weitergeben.

# --- Pflicht ---------------------------------------------------------------
# Passwort für die Anmeldung am Dashboard (mind. 8 Zeichen)
DASHBOARD_PASSWORD=bitte-aendern

# RCON-Zugang zum Minecraft-Server (bei Hostern: IP und RCON-Port aus dem Webinterface)
RCON_HOST=192.168.1.50
RCON_PORT=25575
RCON_PASSWORD=langes-zufaelliges-rcon-passwort

# --- Optional --------------------------------------------------------------
# Port, unter dem das Dashboard im Heimnetz erreichbar ist (Host-Seite in docker-compose)
DASHBOARD_PORT=8080

# Abfrageintervall in Sekunden (Standard 5) und Intervall für /tps + /mspt (Standard 30)
POLL_INTERVAL_SECONDS=5
PERF_INTERVAL_SECONDS=30

# Zeitüberschreitung für RCON-Antworten in Sekunden
RCON_TIMEOUT_SECONDS=10

# Präfix von Bedrock-Spielern (Floodgate "username-prefix")
FLOODGATE_PREFIX=.

# Zusätzliche Befehle, die eine Bestätigung brauchen (kommagetrennt)
DANGEROUS_COMMANDS=

# Gültigkeit der Anmeldung in Tagen
SESSION_DAYS=30

# Sprachdatei für Item-Namen im Ordner assets/ (z. B. de_de → assets/de_de.json)
LANGUAGE_FILE=de_de

# Zeitzone für die Logs im Container
TZ=Europe/Berlin

# Nur setzen, wenn das Dashboard hinter einem Reverse-Proxy (z. B. Synology mit HTTPS) läuft
TRUST_PROXY=false
# auto = Secure-Cookie nur bei HTTPS
COOKIE_SECURE=auto

# Mock-Modus mit Beispieldaten (ohne echten Server; Passwort dann "mock",
# falls DASHBOARD_PASSWORD nicht gesetzt ist)
MOCK=false
